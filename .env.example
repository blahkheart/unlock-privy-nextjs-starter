# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# Privy App ID (get from https://dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================

# Chain ID for the network you want to use
# Supported networks:
#   - 1: Ethereum Mainnet
#   - 5: Goerli Testnet (deprecated)
#   - 8453: Base Mainnet
#   - 84532: Base Sepolia Testnet (recommended for testing)
#   - 137: Polygon Mainnet
#   - 42161: Arbitrum One
#   - 10: Optimism
# Default: 84532 (Base Sepolia)
NEXT_PUBLIC_CHAIN_ID=84532

# ============================================================================
# OPTIONAL: CUSTOM RPC URLS
# ============================================================================
# Override default RPC URLs if you have your own provider
# Leave commented to use public RPCs

# NEXT_PUBLIC_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
# NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
# NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
# NEXT_PUBLIC_OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level for the application
# Options: debug, info, warn, error, silent
# - debug: Show all logs (development)
# - info: Show info, warn, and error logs
# - warn: Show only warnings and errors
# - error: Show only errors
# - silent: No logs (production)
# Default: debug (development), silent (production)
NEXT_PUBLIC_LOG_LEVEL=debug

# ============================================================================
# UNLOCK PROTOCOL CONFIGURATION
# ============================================================================
# Unlock factory addresses are automatically configured per network
# See lib/blockchain/shared/abi-definitions.ts for all supported networks
#
# Supported networks with Unlock Protocol:
#   - Ethereum Mainnet: 0x3d5409CcE1d45233dE1D4eBDEe74b8E004abDD13
#   - Base: 0xd0b14797b9D08493392865647384974470202A78
#   - Base Sepolia: 0x259813B665C8f6074391028ef782e27B65840d89
#   - Polygon: 0xE8E5cd156f89F7bdB267EabD5C43Af3d5AF2A78f
#   - Arbitrum One: 0x1FF7e338d5E582138C46044dc238543Ce555C963
#   - Optimism: 0x99b1348a9129ac49c6de7F11245773dE2f51fB0c

# ============================================================================
# DEVELOPMENT NOTES
# ============================================================================
# 1. Copy this file to .env.local and fill in your values
# 2. Never commit .env.local to version control
# 3. For production, set NEXT_PUBLIC_LOG_LEVEL=silent
# 4. Test on Base Sepolia (84532) before deploying to mainnet

# ============================================================================
# SPECIFIC LOCK ADDRESSES (OPTIONAL)
# ============================================================================
# If you have specific Unlock Protocol locks you want to interact with,
# add them here for easy reference in your application

# Example: Admin lock for role-based access control
# NEXT_PUBLIC_ADMIN_LOCK_ADDRESS=0x...

# Example: Application-specific locks
# NEXT_PUBLIC_MEMBERSHIP_LOCK_ADDRESS=0x...
# NEXT_PUBLIC_PREMIUM_LOCK_ADDRESS=0x...

# Note: These are optional and depend on your application's needs
# The factory addresses for deploying NEW locks are automatically
# configured based on NEXT_PUBLIC_CHAIN_ID (see above)
